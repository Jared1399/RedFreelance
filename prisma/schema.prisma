// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//models

model User {
  id                     String           @id @default(uuid())
  firstName              String
  lastName               String
  email                  String           @unique
  passwordHash           String?
  identification         String?          @unique
  phone                  String?
  userImg                String?          @default("/not_found.png")
  isFreelancer           Boolean          @default(false)
  rankCommunity          Float            @default(0)
  rankPlatform           Float            @default(0)
  subscriptionStart      DateTime?
  subscriptionEnd        DateTime?
  isVerified             Boolean          @default(false)
  warningCount           Int              @default(0)
  createdAt              DateTime?        @default(now())
  updatedAt              DateTime?        @updatedAt
  subscriptionPlan       SubscriptionPlan @default(basic)
  level                  Level            @default(novice)
  categories             Category[]
  gigs                   Gig[]
  portfolio              Portfolio?
  notifications          Notification[]
  ads                    Ad[]
  Likes                  Likes[]
  freelancerTransactions Transaction[]    @relation("FreelancerTransactions")
  clientTransactions     Transaction[]    @relation("ClientTransactions")
  clientFeedback         Feedback[]       @relation("ClientFeedback")
  freelancerFeedback     Feedback[]       @relation("FreelancerFeedback")
  following              Follow[]         @relation("UserFollowing")
  followers              Follow[]         @relation("UserFollowers")
  blogComments           BlogComment[]
  Blog                   Blog[]

  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model Likes {
  id        String    @id @default(uuid())
  userId    String
  gigId     String
  createdAt DateTime? @default(now())

  user User @relation(fields: [userId], references: [id])
  gig  Gig  @relation(fields: [gigId], references: [id])
}

model Follow {
  id          String @id @default(uuid())
  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Gig {
  id           String        @id @default(uuid())
  gigImg       String?
  title        String
  description  String
  price        Int           @default(0)
  status       GigStatus     @default(active)
  categories   Category[]
  ads          Ad[]
  created_at   DateTime?     @default(now())
  updated_at   DateTime?     @updatedAt
  userId       String?
  transactions Transaction[]
  likeCount    Int           @default(0)
  Likes        Likes[]

  user    User?     @relation(fields: [userId], references: [id])
  GigTier GigTier[]
}

model GigTier {
  id           String  @id @default(uuid())
  name         String
  price        Int
  description  String?
  deliveryTime Int?

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id])

  transactions Transaction[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
  userId      String?

  User User? @relation(fields: [userId], references: [id])
  gigs Gig[]
}

model Ad {
  id         String    @id @default(uuid())
  gigId      String
  userId     String
  startDate  DateTime?
  endDate    DateTime?
  amountPaid Decimal?  @db.Decimal(15, 2)
  status     AdStatus  @default(active)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  gig  Gig  @relation(fields: [gigId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Feedback {
  id           String    @id @default(uuid())
  clientId     String
  freelancerId String
  rating       Int
  comment      String?
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  client     User @relation("ClientFeedback", fields: [clientId], references: [id])
  freelancer User @relation("FreelancerFeedback", fields: [freelancerId], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean   @default(false)
  relatedId String?
  createdAt DateTime? @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Portfolio {
  id          String    @id @default(uuid())
  userId      String    @unique
  title       String
  description String?
  fileUrl     String?
  externalUrl String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Lifecycle {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @updatedAt
  Transaction Transaction[]
}

model Transaction {
  id             String       @id @default(uuid())
  freelancerId   String
  clientId       String
  gigId          String
  lifecycleId    Int          @default(1)
  tierId         String
  amount         Decimal
  requestDetails String
  commission     Decimal
  commissionRate Float        @default(0.10)
  paymentId      String?
  escrowStatus   EscrowStatus @default(held)
  completed      Boolean      @default(false)
  createdAt      DateTime?    @default(now())
  updatedAt      DateTime?    @updatedAt

  tier         GigTier        @relation(fields: [tierId], references: [id])
  freelancer   User           @relation("FreelancerTransactions", fields: [freelancerId], references: [id])
  client       User           @relation("ClientTransactions", fields: [clientId], references: [id])
  gig          Gig            @relation(fields: [gigId], references: [id])
  lifecycle    Lifecycle      @relation(fields: [lifecycleId], references: [id])
  Conversation Conversation[]
}

model Blog {
  id         Int            @id @default(autoincrement())
  title      String
  content    String
  createdAt  DateTime       @default(now())
  authorId   String
  categoryId BlogCategory[]
  comments   BlogComment[]

  author User @relation(fields: [authorId], references: [id])
}

model BlogCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
  Blog Blog[]
}

model BlogComment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  authorId  String
  blogId    Int

  author User @relation(fields: [authorId], references: [id])
  blog   Blog @relation(fields: [blogId], references: [id])
}

model Conversation {
  id            String                    @id @default(uuid())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  transactionId String
  transaction   Transaction               @relation(fields: [transactionId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String  @id @default(uuid())
  userId         String
  conversationId String?

  user         User          @relation(fields: [userId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([userId, conversationId])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  metadata       Json?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

//enums
enum SubscriptionPlan {
  basic
  pro
}

enum Level {
  novice
  advanced
  expert
}

enum GigStatus {
  active
  inactive
  completed
}

enum AdStatus {
  active
  inactive
}

enum EscrowStatus {
  held
  released
  refunded
}
